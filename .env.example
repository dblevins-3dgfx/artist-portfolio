# At least 12 characters. Do not use a password you use anywhere else.
# The studio desk at /studio stays locked until this is set.
STUDIO_PASSWORD=replace-with-a-long-password

# Where print requests should be emailed, if you turn on delivery.
STUDIO_EMAIL=studio@example.com

# Optional. When both are set, each print request is also emailed.
# Create a key at https://resend.com and verify the domain you send from.
# RESEND_API_KEY=
# RESEND_FROM="Studio <prints@yourdomain.com>"
